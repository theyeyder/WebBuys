  vigenciaDesde         DateTime? @db.Date
  vigenciaHasta         DateTime? @db.Date
  rangoAutorizadoDesde  Int       @default(1)
  rangoAutorizadoHasta  Int       @default(999999)
  consecutivoActual     Int       @default(1)
  iva                   Decimal   @default(19) @db.Decimal(5, 2)
  piePaginaFactura      String    @default("") @db.Text
  observacionesFactura  String    @default("") @db.Text
  consecutivoRuta       Int       @default(0)
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  @@map("configuraciones")
}

model Preferencia {
  id                         String   @id @default(uuid()) @db.Uuid
  legacyMongoId              String?  @unique @db.VarChar(24)
  clave                      String   @unique @default("principal") @db.VarChar(30)
  moneda                     String   @default("COP") @db.VarChar(10)
  simboloMoneda              String   @default("$") @db.VarChar(10)
  decimales                  Int      @default(0)
  formatoFecha               String   @default("DD/MM/YYYY") @db.VarChar(20)
  permitirInventarioNegativo Boolean  @default(false)
  confirmarAntesEliminar     Boolean  @default(true)
  createdAt                  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime @updatedAt @db.Timestamptz(3)

  @@map("preferencias")
}

model Consecutivo {
  id            String   @id @default(uuid()) @db.Uuid
  legacyMongoId String?  @unique @db.VarChar(24)
  clave         String   @unique @db.VarChar(80)
  ultimoNumero  Int      @default(0)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  @@map("consecutivos")
}
