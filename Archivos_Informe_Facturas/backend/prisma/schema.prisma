generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================================================
// WEBBUYS - ESQUEMA POSTGRESQL / PRISMA
// FASE 1: diseño relacional compatible con el dominio actual
// =========================================================

model Usuario {
  id                    String    @id @default(uuid()) @db.Uuid
  legacyMongoId         String?   @unique @db.VarChar(24)
  codigo                String?   @unique @db.VarChar(40)
  nombres               String    @db.VarChar(120)
  documento             String    @unique @db.VarChar(40)
  apellidos              String    @db.VarChar(120)
  usuario               String    @unique @db.VarChar(80)
  password              String    @db.VarChar(255)
  rol                    String    @default("Empleado") @db.VarChar(30)
  perfilId               String?   @db.Uuid
  estado                 String    @default("Activo") @db.VarChar(30)
  debeCambiarPassword    Boolean   @default(false)
  ultimoIngreso          DateTime? @db.Timestamptz(3)
  creadoPorId            String?   @db.Uuid
  createdAt              DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime  @updatedAt @db.Timestamptz(3)

  creadoPor              Usuario?  @relation("UsuarioCreadoPor", fields: [creadoPorId], references: [id], onDelete: SetNull)
  usuariosCreados        Usuario[] @relation("UsuarioCreadoPor")
  perfil                 PerfilUsuario? @relation("UsuarioPerfilPrincipal", fields: [perfilId], references: [id], onDelete: SetNull)
  perfiles               UsuarioPerfil[]
  permisosPersonalizados UsuarioPermiso[]

  auditorias             Auditoria[]
  categoriasCreadas      Categoria[] @relation("CategoriaCreadoPor")
  productosCreados       Producto[] @relation("ProductoCreadoPor")
  empleados              Empleado[]
  rutasResponsable       Ruta[] @relation("RutaUsuarioResponsable")
  pedidosCreados         Pedido[] @relation("PedidoCreadoPor")
  entregasConfirmadas    Entrega[] @relation("EntregaConfirmadoPor")
  entregasActualizadas   Entrega[] @relation("EntregaActualizadoPor")
  facturasCreadas        Factura[] @relation("FacturaCreadoPor")
  movimientosInventario  MovimientoInventario[]
  cajasAbiertas          Caja[] @relation("CajaAbiertoPor")
  cajasCerradas          Caja[] @relation("CajaCerradoPor")
  movimientosCaja        MovimientoCaja[]
  carterasCreadas        Cartera[] @relation("CarteraCreadoPor")
  carterasActualizadas   Cartera[] @relation("CarteraActualizadoPor")
  pagosCartera           PagoCartera[]

  @@index([estado])
  @@index([rol])
  @@index([perfilId])
  @@map("usuarios")
}


model PerfilUsuario {
  id          String   @id @default(uuid()) @db.Uuid
  codigo      String   @unique @db.VarChar(40)
  nombre      String   @unique @db.VarChar(120)
  descripcion String   @default("") @db.Text
  estado      String   @default("Activo") @db.VarChar(20)
  esSistema   Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  usuariosPrincipales Usuario[]       @relation("UsuarioPerfilPrincipal")
  usuarios            UsuarioPerfil[]
  permisos            PerfilPermiso[]

  @@index([estado])
  @@map("perfiles_usuario")
}


model UsuarioPerfil {
  usuarioId  String   @db.Uuid
  perfilId   String   @db.Uuid
  asignadoAt DateTime @default(now()) @db.Timestamptz(3)

  usuario Usuario       @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  perfil  PerfilUsuario @relation(fields: [perfilId], references: [id], onDelete: Cascade)

  @@id([usuarioId, perfilId])
  @@index([perfilId])
  @@map("usuario_perfiles")
}

model PerfilPermiso {
  perfilId             String  @db.Uuid
  modulo               String  @db.VarChar(60)
  ver                  Boolean @default(false)
  crear                Boolean @default(false)
  editar               Boolean @default(false)
  eliminar             Boolean @default(false)
  imprimir             Boolean @default(false)
  anular               Boolean @default(false)
  cambiarEstado        Boolean @default(false)
  registrarMovimientos Boolean @default(false)

  perfil PerfilUsuario @relation(fields: [perfilId], references: [id], onDelete: Cascade)

  @@id([perfilId, modulo])
  @@index([modulo])
  @@map("perfil_permisos")
}

model UsuarioPermiso {
  usuarioId            String   @db.Uuid
  modulo               String   @db.VarChar(60)
  ver                  Boolean?
  crear                Boolean?
  editar               Boolean?
  eliminar             Boolean?
  imprimir             Boolean?
  anular               Boolean?
  cambiarEstado        Boolean?
  registrarMovimientos Boolean?

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@id([usuarioId, modulo])
  @@index([modulo])
  @@map("usuario_permisos")
}

model Auditoria {
  id              String   @id @default(uuid()) @db.Uuid
  legacyMongoId   String?  @unique @db.VarChar(24)
  usuarioId       String?  @db.Uuid
  codigoUsuario   String   @default("") @db.VarChar(40)
  nombreUsuario   String   @default("") @db.VarChar(250)
  modulo          String   @db.VarChar(80)
  accion          String   @db.VarChar(40)
  registroId      String?  @db.VarChar(64)
  codigoRegistro  String   @default("") @db.VarChar(80)
  descripcion     String   @default("") @db.Text
  datosAnteriores Json?    @db.JsonB
  datosNuevos     Json?    @db.JsonB
  ip              String   @default("") @db.VarChar(64)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  usuario         Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([modulo])
  @@index([accion])
  @@index([usuarioId])
  @@map("auditorias")
}

model Categoria {
  id            String   @id @default(uuid()) @db.Uuid
  legacyMongoId String?  @unique @db.VarChar(24)
  codigo        String   @unique @db.VarChar(40)
  nombre        String   @unique @db.VarChar(120)
  descripcion   String   @default("") @db.Text
  estado        String   @default("Activa") @db.VarChar(20)
  creadoPorId   String?  @db.Uuid
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  creadoPor     Usuario?  @relation("CategoriaCreadoPor", fields: [creadoPorId], references: [id], onDelete: SetNull)
  productos     Producto[]

  @@index([estado])
  @@map("categorias")
}

model ZonaDespacho {
  id            String   @id @default(uuid()) @db.Uuid
  legacyMongoId String?  @unique @db.VarChar(24)
  codigo        String?  @unique @db.VarChar(40)
  nombre        String   @unique @db.VarChar(120)
  descripcion   String   @default("") @db.Text
  estado        String   @default("Activa") @db.VarChar(20)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  clientes      Cliente[]
  rutas         RutaZona[]
  pedidos       Pedido[]
  entregas      Entrega[]

  @@index([estado])
  @@map("zonas_despacho")
}

model Ruta {
  id                   String   @id @default(uuid()) @db.Uuid
  legacyMongoId        String?  @unique @db.VarChar(24)
  codigo               String   @unique @db.VarChar(40)
  nombre               String   @db.VarChar(120)
  descripcion          String   @default("") @db.Text
  usuarioResponsableId String?  @db.Uuid
  diasAtencion         String[] @default([])
  estado               String   @default("Activa") @db.VarChar(20)
  createdAt            DateTime @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @db.Timestamptz(3)

  // Conserva el antiguo Ruta.empleado -> Usuario para no perder datos.
  // La asignación operativa canónica queda en Empleado.rutaAsignadaId.
  usuarioResponsable   Usuario? @relation("RutaUsuarioResponsable", fields: [usuarioResponsableId], references: [id], onDelete: SetNull)
  zonas                RutaZona[]
  empleadosAsignados   Empleado[]
  pedidos              Pedido[]
  entregas             Entrega[]

  @@index([nombre])
  @@index([usuarioResponsableId])
  @@index([estado])
  @@map("rutas")
}

model RutaZona {
  id       String @id @default(uuid()) @db.Uuid
  rutaId   String @db.Uuid
  zonaId   String @db.Uuid

  ruta     Ruta         @relation(fields: [rutaId], references: [id], onDelete: Cascade)
  zona     ZonaDespacho @relation(fields: [zonaId], references: [id], onDelete: Cascade)

  @@unique([rutaId, zonaId])
  @@index([zonaId])
  @@map("ruta_zonas")
}

model Cliente {
  id               String   @id @default(uuid()) @db.Uuid
  legacyMongoId    String?  @unique @db.VarChar(24)
  codigo           String?  @unique @db.VarChar(40)
  tipoDocumento    String   @default("CC") @db.VarChar(10)
  documento        String   @unique @db.VarChar(40)
  nombre           String   @db.VarChar(180)
  razonSocial      String   @default("") @db.VarChar(200)
  telefono         String   @default("") @db.VarChar(40)
  direccion        String   @default("") @db.VarChar(250)
  barrio           String   @default("") @db.VarChar(120)
  zonaDespachoId   String?  @db.Uuid
  ciudad           String   @default("") @db.VarChar(120)
  tipoCliente      String   @default("Tienda") @db.VarChar(40)
  estado           Boolean  @default(true)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  zonaDespacho     ZonaDespacho? @relation(fields: [zonaDespachoId], references: [id], onDelete: SetNull)
  pedidos          Pedido[]
  entregas         Entrega[]
  facturas         Factura[]
  movimientosCaja  MovimientoCaja[]
  carteras         Cartera[]
  pagosCartera     PagoCartera[]

  @@index([zonaDespachoId])
  @@index([estado])
  @@index([nombre])
  @@map("clientes")
}

model Empleado {
  id             String   @id @default(uuid()) @db.Uuid
  legacyMongoId  String?  @unique @db.VarChar(24)
  codigo         String   @unique @db.VarChar(40)
  tipoDocumento  String   @default("CC") @db.VarChar(20)
  documento      String   @unique @db.VarChar(40)
  nombres        String   @db.VarChar(120)
  apellidos       String   @db.VarChar(120)
  telefono       String   @default("") @db.VarChar(40)
  direccion      String   @default("") @db.VarChar(250)
  ciudad         String   @default("Ibagué") @db.VarChar(120)
  cargo          String   @db.VarChar(120)
  fechaIngreso   DateTime @default(now()) @db.Date
  salario        Decimal  @default(0) @db.Decimal(18, 2)
  rutaAsignadaId String?  @db.Uuid
  usuarioId      String?  @db.Uuid
  estado         String   @default("Activo") @db.VarChar(20)
  observaciones  String   @default("") @db.Text
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  rutaAsignada   Ruta?    @relation(fields: [rutaAsignadaId], references: [id], onDelete: SetNull)
  usuario        Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  pedidosAtendidos  Pedido[]  @relation("PedidoEmpleado")
  pedidosEmpacados  Pedido[]  @relation("PedidoEmpacador")
  entregasEmpacadas Entrega[] @relation("EntregaEmpacador")
  entregasRepartidas Entrega[] @relation("EntregaRepartidor")
  facturasAtendidas Factura[] @relation("FacturaEmpleado")
  facturasEmpacadas Factura[] @relation("FacturaEmpacador")
  facturasRepartidas Factura[] @relation("FacturaRepartidor")

  @@index([nombres, apellidos])
  @@index([cargo, estado])
  @@index([rutaAsignadaId])
  @@index([usuarioId])
  @@map("empleados")
}

model Producto {
  id                 String   @id @default(uuid()) @db.Uuid
  legacyMongoId      String?  @unique @db.VarChar(24)
  codigo             String   @unique @db.VarChar(40)
  nombre             String   @db.VarChar(180)
  categoriaId        String   @db.Uuid
  marca              String   @default("") @db.VarChar(120)
  descripcion        String   @default("") @db.Text
  tipoVenta          String   @default("Unidad") @db.VarChar(20)
  unidad             String   @default("Unidad") @db.VarChar(40)
  precioCompra       Decimal  @default(0) @db.Decimal(18, 2)
  precioVenta        Decimal  @db.Decimal(18, 2)
  stock              Decimal  @default(0) @db.Decimal(18, 4)
  stockReservado     Decimal  @default(0) @db.Decimal(18, 4)
  stockMinimo        Decimal  @default(0) @db.Decimal(18, 4)
  controlInventario  Boolean  @default(true)
  costoPromedio      Decimal  @default(0) @db.Decimal(18, 4)
  sabores            String[] @default([])
  imagen             String   @default("") @db.Text
  estado             String   @default("Activo") @db.VarChar(20)
  creadoPorId        String?  @db.Uuid
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)

  categoria          Categoria @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  creadoPor          Usuario?  @relation("ProductoCreadoPor", fields: [creadoPorId], references: [id], onDelete: SetNull)
  reglasPrecio       ReglaPrecio[] @relation("ReglaPrecioProducto")
  presentaciones     ProductoPresentacion[]
  pedidoItems        PedidoItem[]
  entregaItems       EntregaItem[]
  facturaItems       FacturaItem[]
  movimientosInventario MovimientoInventario[]

  @@index([categoriaId, nombre])
  @@index([estado])
  @@map("productos")
}

model ProductoPresentacion {
  id                String   @id @default(uuid()) @db.Uuid
  legacyMongoId     String?  @unique @db.VarChar(24)
  productoId        String   @db.Uuid
  nombre            String   @db.VarChar(180)
  tipoVenta         String   @default("Unidad") @db.VarChar(20)
  unidad            String   @db.VarChar(40)
  precioCompra      Decimal  @default(0) @db.Decimal(18, 2)
  precioVenta       Decimal  @db.Decimal(18, 2)
  stock             Decimal  @default(0) @db.Decimal(18, 4)
  stockReservado    Decimal  @default(0) @db.Decimal(18, 4)
  stockMinimo       Decimal  @default(0) @db.Decimal(18, 4)
  controlInventario Boolean  @default(true)
  costoPromedio     Decimal  @default(0) @db.Decimal(18, 4)
  estado            String   @default("Activa") @db.VarChar(20)
  orden             Int      @default(0)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  producto          Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  reglasPrecio      ReglaPrecio[] @relation("ReglaPrecioPresentacion")
  pedidoItems       PedidoItem[]
  entregaItems      EntregaItem[]
  movimientosInventario MovimientoInventario[]

  @@unique([productoId, nombre])
  @@index([productoId, estado])
  @@map("producto_presentaciones")
}

model ReglaPrecio {
  id             String   @id @default(uuid()) @db.Uuid
  legacyMongoId  String?  @db.VarChar(24)
  productoId     String?  @db.Uuid
  presentacionId String?  @db.Uuid
  desde          Decimal  @db.Decimal(18, 4)
  precio         Decimal  @db.Decimal(18, 2)
  orden          Int      @default(0)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  producto       Producto? @relation("ReglaPrecioProducto", fields: [productoId], references: [id], onDelete: Cascade)
  presentacion   ProductoPresentacion? @relation("ReglaPrecioPresentacion", fields: [presentacionId], references: [id], onDelete: Cascade)

  @@index([productoId, desde])
  @@index([presentacionId, desde])
  @@map("reglas_precio")
}

model Pedido {
  id                     String    @id @default(uuid()) @db.Uuid
  legacyMongoId          String?   @unique @db.VarChar(24)
  codigo                 String    @unique @db.VarChar(40)
  clienteId              String?   @db.Uuid
  clienteCodigo          String    @default("") @db.VarChar(40)
  clienteNombre          String    @default("") @db.VarChar(180)
  clienteRazonSocial     String    @default("") @db.VarChar(200)
  clienteTelefono        String    @default("") @db.VarChar(40)
  clienteDireccion       String    @default("") @db.VarChar(250)
  clienteBarrio          String    @default("") @db.VarChar(120)
  clienteCiudad          String    @default("") @db.VarChar(120)
  clienteTipo            String    @default("") @db.VarChar(40)
  zonaDespachoId         String?   @db.Uuid
  zonaDespachoCodigo     String    @default("") @db.VarChar(40)
  zonaDespachoNombre     String    @default("") @db.VarChar(120)
  rutaId                 String?   @db.Uuid
  rutaCodigo             String    @default("") @db.VarChar(40)
  rutaNombre             String    @default("") @db.VarChar(120)
  rutaDiasAtencion       String[]  @default([])
  empleadoId             String    @db.Uuid
  empacadorId            String?   @db.Uuid
  subtotal               Decimal   @default(0) @db.Decimal(18, 2)
  descuento              Decimal   @default(0) @db.Decimal(18, 2)
  total                  Decimal   @default(0) @db.Decimal(18, 2)
  estado                 String    @default("Borrador") @db.VarChar(40)
  inventarioReservado    Boolean   @default(false)
  fechaReservaInventario DateTime? @db.Timestamptz(3)
  fechaEntrega           DateTime? @db.Date
  observaciones          String    @default("") @db.Text
  creadoPorId            String?   @db.Uuid
  createdAt              DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime  @updatedAt @db.Timestamptz(3)

  cliente                Cliente?      @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  zonaDespacho           ZonaDespacho? @relation(fields: [zonaDespachoId], references: [id], onDelete: SetNull)
  ruta                   Ruta?         @relation(fields: [rutaId], references: [id], onDelete: SetNull)
  empleado               Empleado      @relation("PedidoEmpleado", fields: [empleadoId], references: [id], onDelete: Restrict)
  empacador              Empleado?     @relation("PedidoEmpacador", fields: [empacadorId], references: [id], onDelete: SetNull)
  creadoPor              Usuario?      @relation("PedidoCreadoPor", fields: [creadoPorId], references: [id], onDelete: SetNull)
  items                  PedidoItem[]
  entrega                Entrega?
  facturas               Factura[]
  movimientosInventario  MovimientoInventario[]
  movimientosCaja        MovimientoCaja[]
  carteras               Cartera[]
  pagosCartera           PagoCartera[]

  @@index([clienteId, createdAt(sort: Desc)])
  @@index([empleadoId, createdAt(sort: Desc)])
  @@index([empacadorId, createdAt(sort: Desc)])
  @@index([estado, createdAt(sort: Desc)])
  @@index([rutaId])
  @@index([zonaDespachoId])
  @@map("pedidos")
}

model PedidoItem {
  id                   String   @id @default(uuid()) @db.Uuid
  legacyMongoId        String?  @unique @db.VarChar(24)
  pedidoId             String   @db.Uuid
  productoId           String   @db.Uuid
  codigoProducto       String   @default("") @db.VarChar(40)
  nombre               String   @db.VarChar(180)
  marca                String   @default("") @db.VarChar(120)
  tipoVenta            String   @db.VarChar(20)
  unidad               String   @db.VarChar(40)
  presentacionId       String?  @db.Uuid
  presentacionNombre   String   @default("") @db.VarChar(180)
  cantidad             Int
  precioNormal         Decimal  @db.Decimal(18, 2)
  precioAplicado       Decimal  @db.Decimal(18, 2)
  aplicoPrecioCantidad Boolean  @default(false)
  reglaAplicadaDesde   Decimal? @db.Decimal(18, 4)
  subtotal             Decimal  @db.Decimal(18, 2)
  orden                Int      @default(0)
  createdAt            DateTime @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @db.Timestamptz(3)

  pedido               Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  producto             Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)
  presentacion         ProductoPresentacion? @relation(fields: [presentacionId], references: [id], onDelete: Restrict)
  entregaItems         EntregaItem[]

  @@index([pedidoId, orden])
  @@index([productoId])
  @@index([presentacionId])
  @@map("pedido_items")
}

model Entrega {
  id                       String    @id @default(uuid()) @db.Uuid
  legacyMongoId            String?   @unique @db.VarChar(24)
  pedidoId                 String    @unique @db.Uuid
  pedidoCodigo             String    @db.VarChar(40)
  clienteId                String?   @db.Uuid
  clienteCodigo            String    @default("") @db.VarChar(40)
  clienteNombre            String    @default("") @db.VarChar(180)
  clienteTelefono          String    @default("") @db.VarChar(40)
  clienteDireccion         String    @default("") @db.VarChar(250)
  clienteBarrio            String    @default("") @db.VarChar(120)
  clienteCiudad            String    @default("") @db.VarChar(120)
  zonaDespachoId           String?   @db.Uuid
  zonaDespachoNombre       String    @default("") @db.VarChar(120)
  rutaId                   String?   @db.Uuid
  rutaNombre               String    @default("") @db.VarChar(120)
  rutaDiasAtencion         String[]  @default([])
  fechaProgramada          DateTime? @db.Date
  empacadorId              String?   @db.Uuid
  repartidorId             String?   @db.Uuid
  subtotal                 Decimal   @default(0) @db.Decimal(18, 2)
  descuento                Decimal   @default(0) @db.Decimal(18, 2)
  total                    Decimal   @default(0) @db.Decimal(18, 2)
  metodoPago               String    @default("") @db.VarChar(30)
  confirmada               Boolean   @default(false)
  preparacionGuardada      Boolean   @default(false)
  inventarioPesoReservado  Boolean   @default(false)
  inventarioDescontado     Boolean   @default(false)
  fechaReservaInventario   DateTime? @db.Timestamptz(3)
  fechaSalidaInventario    DateTime? @db.Timestamptz(3)
  fechaPreparacion         DateTime? @db.Timestamptz(3)
  fechaConfirmacion        DateTime? @db.Timestamptz(3)
  confirmadoPorId          String?   @db.Uuid
  estado                   String    @default("Por preparar") @db.VarChar(40)
  motivoCancelacion        String    @default("") @db.Text
  motivoNoEntrega          String    @default("") @db.Text
  observaciones            String    @default("") @db.Text
  fechaSalida              DateTime? @db.Timestamptz(3)
  fechaEntregaReal         DateTime? @db.Timestamptz(3)
  actualizadoPorId         String?   @db.Uuid
  createdAt                DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime  @updatedAt @db.Timestamptz(3)

  pedido                   Pedido        @relation(fields: [pedidoId], references: [id], onDelete: Restrict)
  cliente                  Cliente?      @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  zonaDespacho             ZonaDespacho? @relation(fields: [zonaDespachoId], references: [id], onDelete: SetNull)
